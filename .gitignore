# -------------------------------------------------------------------------
# Data & Large Files
# -------------------------------------------------------------------------
# UPDATED: Ignore contents in the solution data directory
solution/data/*

!solution/data/.gitkeep
!report/.gitkeep

# Ignore common data formats found elsewhere in the project
# (These work automatically in subfolders)
*.csv
*.tsv
*.xlsx
*.xls
*.json
*.parquet
*.pkl
*.h5
*.hdf5
*.db
*.sqlite

# -------------------------------------------------------------------------
# Jupyter Notebooks
# -------------------------------------------------------------------------
# Ignore Jupyter checkpoint folders (auto-generated backups)
.ipynb_checkpoints/
*/.ipynb_checkpoints/
solution/notebook/.ipynb_checkpoints/

# Optional: Ignore HTML or PDF exports if you only want the source .ipynb
*.html
*.pdf

# -------------------------------------------------------------------------
# Python & Compilation
# -------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -------------------------------------------------------------------------
# Environments (Miniconda/Virtualenv)
# -------------------------------------------------------------------------
# While you track environment.yml, you generally ignore the actual env folder
env/
venv/
ENV/
env.bak/
venv.bak/
.env
.venv
.envrc
.direnv/
.conda/

# -------------------------------------------------------------------------
# IDE & System Files
# -------------------------------------------------------------------------
